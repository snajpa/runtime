.idea
.DS_Store
.env*
!/.envrc
.last_used_env
.air
go.work.sum
.infisical.json
.vscode/mise-tools
/packages/fc-kernels
/packages/fc-versions
**/bin/

# Nix dev environment
/result
/result-*
/*.qcow2
/e2b-dev-vm/

# `go build ./nix/rehearsal/...` (and the push gate's build step) writes the
# rehearsal driver's and peer's binaries into the working directory.
/driver
/peer

# `go build ./cmd/migrate-builds` drops a binary in the working directory
# (the repo root, packages/orchestrator, or the package directory); it is a
# build artifact, never a source file.
/migrate-builds
/packages/orchestrator/migrate-builds
/packages/orchestrator/cmd/migrate-builds/migrate-builds
